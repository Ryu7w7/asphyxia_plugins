  ];

div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-edit
        | Settings
    .card-content
      form(method="post" action="/emit/iidxUpdateCustom")
        h3.title.is-4(style="margin-top: 1.5rem; margin-bottom: 0.5rem; border-bottom: 1px solid #dbdbdb; padding-bottom: 0.5rem;") General Settings
        .columns.is-multiline
          .column.is-half
            .field
              input(type="text" name="refid", value=refid readonly hidden)
              label.label IIDX ID
              .control
                input.input(type="text" name="iidxid", value=profile.idstr readonly)
          .column.is-half
            .field
              label.label Version
              .control
                .select
                  select(name="version", id="version")
                    each i in version
                      option(selected=(i==pcdata.version)) #{i}
          .column.is-half
            .field
              label.label Name
              .control
                input.input(type="text" name="name", id="name", value=profile.name)
        h3.title.is-4(style="margin-top: 1.5rem; margin-bottom: 0.5rem; border-bottom: 1px solid #dbdbdb; padding-bottom: 0.5rem;") Visual Customization
        .columns.is-multiline
          .column.is-half
            .field
              label.label Frame
              .control
                .select
                  select(name="frame", id="frame")
                    each val, index in customData.frame
                      option(value=index selected=(index==custom.frame)) #{val}
          .column.is-half
            .field
              label.label Turntable
              .control
                .select
                  select(name="turntable", id="turntable")
                    each val, index in customData.turntable
                      option(value=index selected=(index==custom.turntable)) #{val}
          .column.is-half
            .field
              label.label Note Burst
              .control
                .select
                  select(name="note_burst", id="note_burst")
                    each val, index in customData.note_burst
                      option(value=index selected=(index==custom.note_burst)) #{val}
          .column.is-half
            .field
              label.label Menu Music
              .control
                .select
                  select(name="menu_music", id="menu_music")
                    each val, index in customData.menu_music
                      option(value=index selected=(index==custom.menu_music)) #{val}
          .column.is-half
            .field
              label.label Lane Cover
              .control
                .select
                  select(name="lane_cover", id="lane_cover")
                    each val, index in customData.lane_cover
                      option(value=index selected=(index==custom.lane_cover)) #{val}
          .column.is-half
            .field
              label.label Category Voice
              .control
                .select
                  select(name="category_vox", id="category_vox")
                    each val, index in customData.category_vox
                      option(value=index selected=(index==custom.category_vox)) #{val}
          .column.is-half
            .field
              label.label Note Skin
              .control
                .select
                  select(name="note_skin", id="note_skin")
                    each val, index in customData.note_skin
                      option(value=index selected=(index==custom.note_skin)) #{val}
          .column.is-half
            .field
              label.label Full Combo Splash
              .control
                .select
                  select(name="full_combo_splash", id="full_combo_splash")
                    each val, index in customData.full_combo_splash
                      option(value=index selected=(index==custom.full_combo_splash)) #{val}
          .column.is-half
            .field
              label.label Note Beam
              .control
                .select
                  select(name="note_beam", id="note_beam")
                    each val, index in customData.note_beam
                      option(value=index selected=(index==custom.note_beam)) #{val}
          .column.is-half
            .field
              label.label Judgement Font
              .control
                .select
                  select(name="judge_font", id="judge_font")
                    each val, index in customData.judge_font
                      option(value=index selected=(index==custom.judge_font)) #{val}
        h3.title.is-4(style="margin-top: 1.5rem; margin-bottom: 0.5rem; border-bottom: 1px solid #dbdbdb; padding-bottom: 0.5rem;") Play Customization
        .columns.is-multiline
          .column.is-half
            .field
              label.label Disable Music Preview
              .control
                input(type="checkbox" name="disable_musicpreview", id="disable_musicpreview", checked=Boolean(custom.disable_musicpreview))
          .column.is-half
            .field
              label.label Pacemaker Cover
              .control
                input.input(type="number" name="pacemaker_cover", id="pacemaker_cover", value=custom.pacemaker_cover)
          .column.is-half
            .field
              label.label VEFX Lock
