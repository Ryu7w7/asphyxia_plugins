//DATA//
  scores: DB.Find(refid, { collection: 'score' })
-
div
  #tachi-controller-warning.notification(style="background-color:rgba(183,149,19,0.25);color:#f5e6ab;border-left:4px solid #b79513;")
    button.delete(onclick="document.getElementById('tachi-controller-warning').style.display='none';localStorage.setItem('tachi-warning-dismissed','1');")
    p
      strong Scores must be achieved on an arcade-size controller!
    p Playing on other input devices (like a keyboard) will get you in trouble.

  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-swap-horizontal
        | Tachi Score Sync (IIDX)
    .card-content
      .content
        p Synchronize your IIDX scores with #[a(href="https://kamai.tachi.ac" target="_blank") Kamaitachi].

      #tachi-status
        .notification.is-info.is-light
          span.icon
            i.mdi.mdi-loading.mdi-spin
          |  Checking Tachi authorization status...

      #tachi-not-authorized(style="display:none")
        .notification(style="background-color:rgba(255,183,77,0.15);color:#ffb74d;")
          p You are not yet authorized with Tachi. Click the button below to connect your account.
        .field
          button.button.is-link#tachi-authorize-btn
            span.icon
              i.mdi.mdi-link
            span Authorize with Tachi

      #tachi-authorized(style="display:none")
        .level
          .level-left
            .level-item
              span.tag.is-success.is-medium
                span.icon
                  i.mdi.mdi-check-circle
                span Connected to Tachi
        .field.is-grouped.is-grouped-multiline
          .control
            .field.has-addons
              .control
                button.button.is-link#tachi-sync-btn(data-tooltip="Import from Tachi, then export local scores to Tachi" data-tooltip-position="right")
                  span.icon
                    i.mdi.mdi-sync
                  span Synchronize
              .control
                .dropdown#tachi-sync-dropdown
                  .dropdown-trigger
                    button.button.is-link(aria-haspopup="true" id="tachi-dropdown-btn")
                      span.icon.is-small
                        i.mdi.mdi-chevron-down
                  .dropdown-menu(role="menu")
                    .dropdown-content
                      a.dropdown-item#tachi-upload-btn(data-tooltip="Send new scores to Tachi since last export" data-tooltip-position="right")
                        span.icon
                          i.mdi.mdi-upload
                        |  Export to Tachi
                      a.dropdown-item#tachi-upload-all-btn(data-tooltip="Send all scores to Tachi, ignoring last export time" data-tooltip-position="right")
                        span.icon
                          i.mdi.mdi-upload-multiple
                        |  Force Full Export
                      a.dropdown-item#tachi-import-btn(data-tooltip="Pull personal bests from Tachi into Asphyxia" data-tooltip-position="right")
                        span.icon
                          i.mdi.mdi-download
                        |  Import from Tachi
          .control
            button.button.is-danger.is-outlined#tachi-disconnect-btn
              span.icon
                i.mdi.mdi-link-off
              span Disconnect
        .field.mt-4
          label.checkbox#tachi-auto-export-label
            input(type="checkbox" id="tachi-auto-export-check")
            |  Automatically export scores to Tachi after each play

      #tachi-result(style="display:none")
        .card.mt-4
          .card-header
            p.card-header-title Sync Result
          .card-content
            #tachi-result-content

  #tachi-pb-lists(style="display:none;margin-top:3rem")
    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-format-list-numbered
          | Best 50 Scores (Tachi)
      .card-content
        .columns
          .column
            #tachi-pb-table
              .has-text-centered
                span.icon
                  i.mdi.mdi-loading.mdi-spin
                |  Loading...

div(hidden id='data-pass-scores') !{JSON.stringify(scores)}

script.
  (function() {
    if (localStorage.getItem('tachi-warning-dismissed') === '1') {
      var w = document.getElementById('tachi-controller-warning');
      if (w) w.style.display = 'none';
    }

    if (typeof isOwner !== 'undefined' && !isOwner) {
      document.getElementById('tachi-status').style.display = 'none';
      document.getElementById('tachi-not-authorized').style.display = 'none';
      document.getElementById('tachi-authorized').style.display = 'none';
      document.getElementById('tachi-pb-lists').style.display = 'none';
      var card = document.querySelector('.card-content .content');
      card.innerHTML = '<div class="notification is-warning is-light"><span class="icon"><i class="mdi mdi-lock"></i></span> Tachi Score Sync is only available on your own profile.</div>';
      return;
    }

    var TACHI_CLIENT_ID = '';
    var TACHI_AUTH_URL = '';

    fetch('/tachi/config')
      .then(function(r) { return r.json(); })
      .then(function(cfg) {
        TACHI_CLIENT_ID = cfg.clientId || '';
        TACHI_AUTH_URL = 'https://kamai.tachi.ac/oauth/request-auth?clientID=' + TACHI_CLIENT_ID;
        if (!TACHI_CLIENT_ID) {
          document.getElementById('tachi-status').style.display = 'none';
          document.getElementById('tachi-not-authorized').style.display = '';
          document.getElementById('tachi-not-authorized').innerHTML =
            '<div class="notification is-warning is-light">Tachi Client ID is not configured. Set it in the Asphyxia settings page.</div>';
        }
      });

    var CLEAR_TO_LAMP = {
      1: 'FAILED',
      2: 'ASSIST CLEAR',
      3: 'EASY CLEAR',
      4: 'CLEAR',
      5: 'HARD CLEAR',
      6: 'EX HARD CLEAR',
      7: 'FULL COMBO'
    };

    var DIFF_TO_NAME = {
      0: 'SP BEGINNER',
      1: 'SP NORMAL',
      2: 'SP HYPER',
      3: 'SP ANOTHER',
      4: 'SP LEGGENDARIA',
      6: 'DP NORMAL',
      7: 'DP HYPER',
      8: 'DP ANOTHER',
      9: 'DP LEGGENDARIA'
    };

    function checkStatus() {
      fetch('/tachi/status')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          document.getElementById('tachi-status').style.display = 'none';
          if (data.authorized) {
            document.getElementById('tachi-authorized').style.display = '';
            document.getElementById('tachi-not-authorized').style.display = 'none';
            loadPBLists();
            loadAutoExportState();
          } else {
            document.getElementById('tachi-not-authorized').style.display = '';
            document.getElementById('tachi-authorized').style.display = 'none';
          }
        })
        .catch(function() {
          document.getElementById('tachi-status').innerHTML =
            '<div class="notification is-danger is-light">Failed to check Tachi status.</div>';
        });
    }

    function loadAutoExportState() {
      fetch('/tachi/auto-export?refid=' + encodeURIComponent(refid))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.success) {
            document.getElementById('tachi-auto-export-check').checked = data.enabled;
          }
        })
        .catch(function() {});
    }

    document.getElementById('tachi-auto-export-check').addEventListener('change', function() {
      var enabled = this.checked;
      fetch('/tachi/auto-export', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ refid: refid, enabled: enabled })
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.success) {
            document.getElementById('tachi-auto-export-check').checked = !enabled;
          }
        })
        .catch(function() {
          document.getElementById('tachi-auto-export-check').checked = !enabled;
        });
    });

    checkStatus();

    var dropdownEl = document.getElementById('tachi-sync-dropdown');
    document.getElementById('tachi-dropdown-btn').addEventListener('click', function(e) {
      e.stopPropagation();
      dropdownEl.classList.toggle('is-active');
    });
    document.addEventListener('click', function() {
      dropdownEl.classList.remove('is-active');
    });

    function renderPBTable(scores) {
      var html = '<div style="max-height:500px;overflow:auto;">';
      html += '<table class="table is-narrow is-fullwidth is-striped" style="font-size:0.8em;">';
      html += '<thead><tr><th>#</th><th>Song</th><th>Diff</th><th>EX Score</th><th>Lamp</th></tr></thead><tbody>';
      for (var i = 0; i < scores.length; i++) {
        var s = scores[i];
        html += '<tr><td>' + (i + 1) + '</td><td>' + s.name + '</td><td>' + s.diff + ' ' + (s.level || '') + '</td><td>' + s.score.toLocaleString() + '</td><td>' + s.lamp + '</td></tr>';
      }
      html += '</tbody></table></div>';
      return html;
    }

    function loadPBLists() {
      document.getElementById('tachi-pb-lists').style.display = '';

      fetch('/tachi/pbs/best?game=iidx')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.success || !data.scores || data.scores.length === 0) {
            document.getElementById('tachi-pb-table').innerHTML = '<p class="has-text-grey">No scores found on Tachi.</p>';
            return;
          }
          var scores = data.scores.slice(0, 50).map(function(s) {
            return { name: s.songName, diff: s.difficulty, level: s.level, score: s.score, lamp: s.lamp, vf: s.vf };
          });
          document.getElementById('tachi-pb-table').innerHTML = renderPBTable(scores);
        })
        .catch(function() {
          document.getElementById('tachi-pb-table').innerHTML = '<p class="has-text-danger">Failed to load Tachi PBs.</p>';
        });
    }

    window.addEventListener('message', function(event) {
      if (event.data && event.data.type === 'tachi-auth' && event.data.code) {
        fetch('/tachi/exchange', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: event.data.code })
        })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) {
              checkStatus();
            } else {
              document.getElementById('tachi-status').style.display = '';
              document.getElementById('tachi-status').innerHTML =
                '<div class="notification is-danger is-light">Authorization failed: ' + (data.description || 'Unknown error') + '</div>';
            }
          });
      }
    });

    document.getElementById('tachi-authorize-btn').addEventListener('click', function() {
      window.open(TACHI_AUTH_URL, 'tachi_auth', 'width=600,height=700');
    });

    document.getElementById('tachi-disconnect-btn').addEventListener('click', function() {
      if (!confirm('Disconnect from Tachi?')) return;
      fetch('/tachi/disconnect', { method: 'POST' })
        .then(function() { checkStatus(); });
    });

    function parseTimestamp(ts) {
      if (!ts) return null;
      if (typeof ts === 'number') return ts;
      if (typeof ts === 'string') { var d = new Date(ts).getTime(); return isNaN(d) ? null : d; }
      if (ts.$$date != null) return ts.$$date;
      if (ts instanceof Date || (typeof ts === 'object' && ts.getTime)) { var d = ts.getTime(); return isNaN(d) ? null : d; }
      return null;
    }

    function buildTachiScores(since) {
      var scoresRaw = JSON.parse(document.getElementById('data-pass-scores').textContent);
      var skippedCount = 0;
      var tachiScores = [];

      for (var i = 0; i < scoresRaw.length; i++) {
        var s = scoresRaw[i];
        
        var esArray = s.esArray || [];
        var cArray = s.cArray || [];
        var mArray = s.mArray || [];
        var timeAchieved = parseTimestamp(s.updatedAt || s.createdAt);

        if (since && timeAchieved && timeAchieved <= since) {
          skippedCount++;
          continue; // Skips all difficulties for this song if we do it here. A bit rough, but ok.
        }

        for (var diffIndex in DIFF_TO_NAME) {
          var clid = parseInt(diffIndex);
          if (esArray[clid] > 0 || cArray[clid] > 0) {
            var lamp = CLEAR_TO_LAMP[cArray[clid]];
            if (!lamp) lamp = 'FAILED'; // Fallback if 0 but exscore > 0
            var missCount = mArray[clid] !== undefined ? mArray[clid] : -1;
            
            var tachiScore = {
              score: esArray[clid],
              lamp: lamp,
              matchType: 'inGameID',
              identifier: String(s.mid),
              difficulty: DIFF_TO_NAME[clid],
              timeAchieved: timeAchieved,
            };
            if (missCount !== -1) {
              tachiScore.optional = { bp: missCount };
            }
            tachiScores.push(tachiScore);
          }
        }
      }
      return { tachiScores: tachiScores, skippedCount: skippedCount };
    }

    function exportToTachi(forceAll) {
      var btn = document.getElementById('tachi-sync-btn');
      btn.classList.add('is-loading');
      btn.disabled = true;

      return fetch('/tachi/export-ts?refid=' + encodeURIComponent(refid))
        .then(function(r) { return r.json(); })
        .then(function(tsData) {
          var since = (!forceAll && tsData.success && tsData.timestamp) ? tsData.timestamp : null;
          var result = buildTachiScores(since);
          var tachiScores = result.tachiScores;

          if (tachiScores.length === 0) {
            btn.classList.remove('is-loading');
            btn.disabled = false;
            var msg = 'No scores to upload.';
            if (since) msg = 'No new scores since last export (' + new Date(since).toLocaleString() + '). ' + result.skippedCount + ' scores already exported.';
            return { success: true, _skipped: true, _message: msg, _result: result };
          }

          console.log('Sending ' + tachiScores.length + ' scores to Tachi' + (result.skippedCount > 0 ? ' (skipped ' + result.skippedCount + ' already exported)' : ''));

          // Separate Single and Double scores
          var singleScores = tachiScores.filter(s => s.difficulty.startsWith('SP'));
          var doubleScores = tachiScores.filter(s => s.difficulty.startsWith('DP'));

          var promises = [];
          if (singleScores.length > 0) {
            var exportSingle = singleScores.map(function(s) { return Object.assign({}, s, { difficulty: s.difficulty.replace(/^SP /, '') }); });
            promises.push(fetch('/tachi/import', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ game: 'iidx-sp', playtype: 'Single', scores: exportSingle })
            }).then(r => r.json()));
          }
          if (doubleScores.length > 0) {
            var exportDouble = doubleScores.map(function(s) { return Object.assign({}, s, { difficulty: s.difficulty.replace(/^DP /, '') }); });
            promises.push(fetch('/tachi/import', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ game: 'iidx-dp', playtype: 'Double', scores: exportDouble })
            }).then(r => r.json()));
          }

          return Promise.all(promises).then(function(results) {
            var success = results.every(r => r.success);
            if (success) {
              return fetch('/tachi/save-export-ts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ refid: refid })
              }).then(function() { 
                var combinedData = { success: true, body: { scoreIDs: [], errors: [] } };
                results.forEach(r => {
                  if (r.body && r.body.scoreIDs) combinedData.body.scoreIDs = combinedData.body.scoreIDs.concat(r.body.scoreIDs);
                  if (r.body && r.body.errors) combinedData.body.errors = combinedData.body.errors.concat(r.body.errors);
                });
                return combinedData;
              });
            } else {
              return results[0];
            }
          })
          .then(function(data) {
            btn.classList.remove('is-loading');
            btn.disabled = false;
            return { success: data.success, data: data, scoresSent: tachiScores.length, skippedCount: result.skippedCount, _result: result };
          });
        })
        .catch(function(err) {
          btn.classList.remove('is-loading');
          btn.disabled = false;
          throw err;
        });
    }

    function showExportResult(exportResult) {
      if (exportResult._skipped) {
        showResult('info', exportResult._message);
        return;
      }
      var data = exportResult.data;
      var html = '';
      if (data.success) {
        var body = data.body || {};
        html += '<p class="has-text-success"><strong>Import successful!</strong></p>';
        html += '<p>Scores sent: ' + exportResult.scoresSent + '</p>';
        if (exportResult.skippedCount > 0) html += '<p>Skipped (already exported): ' + exportResult.skippedCount + '</p>';
        if (body.scoreIDs) html += '<p>Scores imported: ' + body.scoreIDs.length + '</p>';
        if (body.errors) html += '<p>Errors: ' + body.errors.length + '</p>';
        if (body.errors && body.errors.length > 0) {
          html += '<details><summary>Error details</summary><ul>';
          for (var j = 0; j < Math.min(body.errors.length, 50); j++) {
            html += '<li>' + (body.errors[j].message || JSON.stringify(body.errors[j])) + '</li>';
          }
          if (body.errors.length > 50) html += '<li>... and ' + (body.errors.length - 50) + ' more</li>';
          html += '</ul></details>';
        }
      } else {
        html += '<p class="has-text-danger"><strong>Import failed</strong></p>';
        html += '<p>' + (data.description || 'Unknown error') + '</p>';
      }
      showResult(data.success ? 'success' : 'danger', html);
    }

    document.getElementById('tachi-upload-btn').addEventListener('click', function(e) {
      e.preventDefault();
      dropdownEl.classList.remove('is-active');
      exportToTachi(false).then(showExportResult).catch(function(err) {
        showResult('danger', '<strong>Error:</strong> ' + err.message);
      });
    });

    document.getElementById('tachi-upload-all-btn').addEventListener('click', function(e) {
      e.preventDefault();
      dropdownEl.classList.remove('is-active');
      exportToTachi(true).then(showExportResult).catch(function(err) {
        showResult('danger', '<strong>Error:</strong> ' + err.message);
      });
    });

    function importFromTachi() {
      return fetch('/tachi/pbs?game=iidx')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.success) {
            return { success: false, description: data.description || 'Failed to fetch PBs from Tachi' };
          }
          if (!data.scores || data.scores.length === 0) {
            return { success: true, imported: 0, skipped: 0, message: 'No scores found on Tachi.' };
          }

          return fetch('/tachi/save-scores', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ refid: refid, game: 'iidx', scores: data.scores })
          })
            .then(function(r) { return r.json(); })
            .then(function(saveResult) {
              if (!saveResult.success) {
                return { success: false, description: saveResult.description || 'Failed to save scores' };
              }
              return { success: true, imported: saveResult.saved, skipped: saveResult.skipped, scores: data.scores };
            });
        });
    }

    document.getElementById('tachi-import-btn').addEventListener('click', function(e) {
      e.preventDefault();
      dropdownEl.classList.remove('is-active');
      var btn = document.getElementById('tachi-sync-btn');
      btn.classList.add('is-loading');
      btn.disabled = true;

      importFromTachi()
        .then(function(result) {
          btn.classList.remove('is-loading');
          btn.disabled = false;

          if (!result.success) {
            showResult('danger', '<strong>Import failed:</strong> ' + (result.description || 'Unknown error'));
            return;
          }

          var html = '<p class="has-text-success"><strong>Import from Tachi complete!</strong></p>';
          html += '<p>Scores imported: ' + (result.imported || 0) + '</p>';
          if (result.skipped) html += '<p>Skipped (already in DB or not improved): ' + result.skipped + '</p>';
          if (result.message) html += '<p>' + result.message + '</p>';
          if (result.imported > 0) html += '<p class="mt-2"><em>Reload the page to see updated scores.</em></p>';
          showResult('success', html);
        })
        .catch(function(err) {
          btn.classList.remove('is-loading');
          btn.disabled = false;
          showResult('danger', '<strong>Error:</strong> ' + err.message);
        });
    });

    document.getElementById('tachi-sync-btn').addEventListener('click', function() {
      var btn = this;
      btn.classList.add('is-loading');
      btn.disabled = true;

      showResult('info', '<p><strong>Synchronizing...</strong></p>');

      importFromTachi()
        .then(function(importResult) {
          btn.classList.remove('is-loading');
          btn.disabled = false;
          return exportToTachi(false).then(function(exportResult) {
            var html = '<p class="has-text-success"><strong>Synchronization complete!</strong></p>';
            html += '<hr><p><strong>Import from Tachi:</strong></p>';
            if (!importResult.success) {
              html += '<p class="has-text-danger">Import failed: ' + (importResult.description || 'Unknown error') + '</p>';
            } else {
              html += '<p>Scores imported: ' + (importResult.imported || 0) + '</p>';
              if (importResult.skipped) html += '<p>Skipped: ' + importResult.skipped + '</p>';
            }
            html += '<hr><p><strong>Export to Tachi:</strong></p>';
            if (exportResult._skipped) {
              html += '<p>' + exportResult._message + '</p>';
            } else if (exportResult.data.success) {
              html += '<p>Scores sent: ' + exportResult.scoresSent + '</p>';
            } else {
              html += '<p class="has-text-danger">Export failed.</p>';
            }
            showResult('success', html);
          });
        })
        .catch(function(err) {
          btn.classList.remove('is-loading');
          btn.disabled = false;
          showResult('danger', '<strong>Sync error:</strong> ' + err.message);
        });
    });

    function showResult(type, html) {
      var resultDiv = document.getElementById('tachi-result');
      var contentDiv = document.getElementById('tachi-result-content');
      resultDiv.style.display = '';
      contentDiv.innerHTML = '<div class="notification is-' + type + ' is-light">' + html + '</div>';
    }
  })();
