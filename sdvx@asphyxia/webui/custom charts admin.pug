//DATA//
  configuredStartRaw: U.GetConfig('sdvx_nautica_id_start')

-
  const NAUTICA_ID_END = 3071;
  const NAUTICA_ID_START_DEFAULT = 2800;
  const parsedStart = parseInt(String(configuredStartRaw || ''), 10);
  const nauticaIdStart = (Number.isFinite(parsedStart) && parsedStart >= 1 && parsedStart < NAUTICA_ID_END)
    ? parsedStart
    : NAUTICA_ID_START_DEFAULT;
  const nauticaCapacity = NAUTICA_ID_END - nauticaIdStart + 1;

link(rel="stylesheet" href="static/asset/css/datatables.css")
link(rel="stylesheet" href="static/asset/css/customcharts.css")
div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-clipboard-check
        | Nominations Queue
    .card-content
      .buttons.are-small.mb-3#nominations-bulk-actions
        button.button.is-info#bulk-test-btn
          span.icon
            i.mdi.mdi-test-tube
          span Test All
        button.button.is-success#bulk-approve-btn
          span.icon
            i.mdi.mdi-check-all
          span Approve All
        button.button.is-danger#bulk-reject-btn
          span.icon
            i.mdi.mdi-close-thick
          span Reject All
      #nominations-queue
        p.has-text-grey Loading nominations...

  #nautica-slots-banner.notification.is-warning.is-light.mt-5
    p
      strong Music ID limit:
      |  The game crashes with IDs >= 3072. Custom charts are assigned IDs starting at
      strong= nauticaIdStart
      | , giving a maximum of
      strong= nauticaCapacity
      |  custom charts. To change this, set
      code sdvx_nautica_id_start
      |  in the plugin config — the lower the value, the more slots (but don't go below the highest official song ID you care about, typically ~1900).

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-check-all
        | Curated Charts
    .card-content
      .buttons.are-small.mb-3
        button.button.is-warning#bulk-reconvert-btn(title="Re-run conversion on every ready/error chart. Re-downloads source ZIPs and overwrites converted files.")
          span.icon
            i.mdi.mdi-refresh
          span Reconvert All
      p.help.mb-3
        span.icon.is-small(style="vertical-align:middle")
          i.mdi.mdi-information-outline
        |  Looking for #[strong Export List] / #[strong Import List]? They
        |  moved next to the curated chart list on the
        |  #[a(href="/plugin/sdvx@asphyxia/custom%20charts") Custom Charts]
        |  tab.
      .field.mb-3
        .control.has-icons-left
          input.input.is-small#curated-search(type="text" placeholder="Filter by title, artist, ID…" style="max-width:360px")
          span.icon.is-small.is-left
            i.mdi.mdi-magnify
      #curated-list
        p.has-text-grey Loading curated charts...

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-google-drive
        | Google Drive Integration
    .card-content
      p.mb-3 Authorize this server to upload converted charts to your Google Drive. Converted chart zips will be stored in the configured Drive folder and served directly from Google's CDN, bypassing your upload bandwidth.
      p.help.mb-3
        | Before clicking: set the OAuth Client ID, Client Secret, and Drive Folder ID in the plugin settings. The OAuth client must have
        | #[code http://localhost:8083/api/drive-oauth-callback] (or your actual server URL) as an Authorized redirect URI.
      a.button.is-link(href="/api/drive-oauth-start" target="_blank")
        span.icon
          i.mdi.mdi-login
        span Authorize with Google Drive

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-delete-clock
        | Deleted Charts
    .card-content
      p.help
        span.icon.is-small(style="vertical-align:middle")
          i.mdi.mdi-information-outline
        |  Deleted charts are excluded from the Nautica browse results above so they don't reappear.
      #deleted-list
        p.has-text-grey Loading deleted charts...

  .card.mt-5
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-server
        | Running your own server
    .card-content
      p
        | If you want to mirror this server's curated chart list on a
        |  fresh asphyxia install, the chart converter (#[strong VoxCharger])
        |  is what turns Nautica/KSM downloads into the #[code .vox] /
        |  #[code .2dx] files the game actually loads. You can grab the
        |  exact build this server was tested with below.
      .field(style="margin-top:1rem;margin-bottom:1rem")
        a.button.is-success(href="/api/voxcharger/download")
          span.icon
            i.mdi.mdi-download
          span Download VoxCharger.exe
      .notification.is-info.is-light(style="margin-top:1rem")
        p
          strong You probably don't need to convert each chart yourself.
        p(style="margin-top:0.5rem")
          | Use #[strong Export List] on the Custom Charts tab to dump
          |  every curated chart on this server (with its ksm.dev source
          |  URL) into a single JSON file. On the new server, click
          |  #[strong Import List] and pick that JSON: every entry lands
          |  as #[code pending], then a single #[strong Reconvert All] on
          |  the Custom Charts Admin page rebuilds them all from the
          |  stored URLs. No per-chart manual work, and no need to copy
          |  multi-gigabyte #[code data_mods/] folders across machines.

script(src="static/asset/js/nautica.js")
