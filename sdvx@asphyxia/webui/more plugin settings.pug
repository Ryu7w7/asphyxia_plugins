-
link(rel="stylesheet" href="static/asset/css/datatables.css")
div
    .card#more-settings
        .card-header
            p.card-header-title
                span.icon
                    i.mdi.mdi-cog
                | More Plugin Settings
        .card-content
            .field#pluginset
    div.field.is-grouped
        div.control.is-expanded
        div.control
            button.button.is-link(id="pluginset-submit") Save
    br
    .card#akaname
        .card-header
            p.card-header-title
                span.icon
                    i.mdi.mdi-star
                | Custom Appeal Titles (One per line, IDs starting from 1, capped at 100 entries)
        .card-content
            .field
                textarea.log-field(rows="20" id="akanameText" name="akanameText")
    div.field.is-grouped
        div.control.is-expanded
        div.control
            button.button.is-link(id="akaname-submit") Save
    br
    .card#flags
        .card-header
            p.card-header-title
                span.icon
                    i.mdi.mdi-star
                | Startup Flags
    div.field.is-grouped
        div.control.is-expanded
        div.control
            button.button.is-link(id="flags-submit") Apply
    br
    .card#fix-scores-section
        .card-header
            p.card-header-title.has-text-danger
                span.icon
                    i.mdi.mdi-alert
                | Server Maintenance: Fix Corrupted SDVX PUCs
        .card-content
            .content
                p This will safely scan all profiles in the entire server and fix the UC -> PUC corruption bug caused by bad migration data. PUCs with less than 10,000,000 score will be safely downgraded back to UC.
                p Due to database limits, this process runs slowly to prevent saturating the server. Please do not close the page until it finishes.
    div.field.is-grouped
        div.control.is-expanded
        div.control
            button.button.is-warning(id="fix-scores-btn")
                span.icon
                    i.mdi.mdi-wrench
                span Run Global Fix

script(src="static/asset/js/pluginsettings.js") 
script.
  document.getElementById('fix-scores-btn').addEventListener('click', function() {
    var btn = this;
    btn.classList.add('is-loading');
    btn.disabled = true;
    
    // First, scan the database to see how many corrupted scores exist
    emit('fixCorruptedScores', { scan: true }).then(function(resScan) {
      if (resScan.error) {
        btn.classList.remove('is-loading');
        btn.disabled = false;
        alert('Failed to scan scores: ' + resScan.error);
        return;
      }
      
      if (resScan.fixed === 0) {
        btn.classList.remove('is-loading');
        btn.disabled = false;
        alert('Good news! No corrupted scores were found on the server.');
        return;
      }
      
      var proceed = confirm("Found " + resScan.fixed + " Corrupted SDVX PUCs across " + resScan.users + " profiles.\n\nProceed to fix them now?");
      if (!proceed) {
        btn.classList.remove('is-loading');
        btn.disabled = false;
        return;
      }
      
      // Proceed to fix the scores
      emit('fixCorruptedScores', {}).then(function(resFix) {
        btn.classList.remove('is-loading');
        btn.disabled = false;
        if (resFix.error) {
          alert('Failed to fix scores: ' + resFix.error);
        } else {
          alert('Done! Successfully fixed ' + resFix.fixed + ' corrupted PUCs across ' + resFix.users + ' user profiles.');
        }
      });
    });
  });
style(type='text/css').
  .log-field {
    width: 100%;
    height: 100%;
    background: #4a4a4a;
    color: #ffffff;
    border-radius: 6px;
    padding: 5px;
    font-size: 20px;
  }