//DATA//
  rivals: DB.Find(refid, { collection: 'rival' })
  yourprofile: DB.Find(refid, { collection: 'profile' })
  profiles: DB.Find(null, { collection: 'profile' })
-
link(rel="stylesheet" href="static/asset/css/datatables.css")
link(rel="stylesheet" href="static/asset/css/score_modal.css")
div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-edit
        | Add rival
    .card-content
      h5 Game
      .field
        .control
          .select.is-fullwidth
            select.select(id="version_select")
      h5 Profile Search
      .field.has-addons
        .control.is-expanded
          input.input(type="text" id="rival-search" placeholder="Search by name or SDVX ID..." autocomplete="off")
        .control
          button.button.is-info(type="button" id="search-btn") 
            span.icon
              i.mdi.mdi-magnify
      
      #search-results.mt-3(style="max-height: 300px; overflow-y: auto;")
        // Dynamic search results will go here
        
      .field.mt-5
        button.button.is-danger.is-outlined(type="button" id="delete-all-rivals")
          span.icon
            i.mdi.mdi-delete-sweep
          span Delete All Rivals
          
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-multiple
        | Current Rivals
    .card-content
      #current-rivals-list(style="max-height: 300px; overflow-y: auto;")
        // Dynamic current rivals will go here

  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-edit
        | Rival Score Comparison
    .card-content
      h5 Select rival to compare with:
      .field
        .control
          .select.is-fullwidth
            select.select(id="rivallist")
              option(value=0) Choose rival

      table.table(id="scorecompare" style="width:100%")
        thead
          tr    
            th ID
            th Song
            th Difficulty
            th Your Score
            th Rival's Score
            th Time
        tbody

div.modal#score-detail-modal
  div.modal-background(onclick="closeScoreModal()")
  div.modal-content.score-modal-content
    div.score-header
      h2#modal-songname Song Name
      div.score-subtitle
        span.diff-badge#modal-diff MXM
    
    div.score-body
      div.score-rank-container
        div#modal-rank(data-grade="S") S

      div.score-stats
        div.score-number#modal-score 9,993,855
        div.score-meta-row
          div.score-meta-item
            span.score-meta-label EX Score
            span.score-meta-value#modal-exscore 0
          div.score-meta-item
            span.score-meta-label Max Combo
            span.score-meta-value#modal-maxchain 0
        div.score-medal-row
          span#modal-medal PLAYED

      div.judgements-container
        div.judgements-title Judgements
        div.judgement-row.j-row-scrit
          span.j-dot
          span.j-label S-CRITICAL
          span.j-value#modal-scrit 0
        div.judgement-row.j-row-crit
          span.j-dot
          span.j-label CRITICAL
          span.j-value#modal-crit 0
        div.judgement-row.j-row-near
          span.j-dot
          span.j-label NEAR
          span.j-value#modal-near 0
        div.j-sub-row
          span.j-sub-item
            span.arrow-early ◀
            span#modal-early 0
          span.j-sub-item
            span#modal-late 0
            span.arrow-late ▶
        div.judgement-row.j-row-error
          span.j-dot
          span.j-label ERROR
          span.j-value#modal-error 0

  button.modal-close.is-large(aria-label="close" onclick="closeScoreModal()")

//div(hidden id='data-pass') !{JSON.stringify(profile)}
div(hidden id='rivals-pass') !{JSON.stringify(rivals)}
div(hidden id='profile-pass') !{JSON.stringify(yourprofile)}
div(hidden id='profiles-pass') !{JSON.stringify(profiles)}
script(src="static/asset/js/rivals.js") 
script(src="static/asset/js/datatables.js")