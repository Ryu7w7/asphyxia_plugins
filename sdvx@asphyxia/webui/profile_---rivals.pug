//DATA//
  rivals: DB.Find(refid, { collection: 'rival' })
  yourprofile: DB.Find(refid, { collection: 'profile' })
  profiles: DB.Find(null, { collection: 'profile' })
-
link(rel="stylesheet" href="static/asset/css/datatables.css")
div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-edit
        | Add rival
    .card-content
      h5 Game
      .field
        .control
          .select.is-fullwidth
            select.select(id="version_select")
      h5 Profile Search
      .field.has-addons
        .control.is-expanded
          input.input(type="text" id="rival-search" placeholder="Search by name or SDVX ID..." autocomplete="off")
        .control
          button.button.is-info(type="button" id="search-btn") 
            span.icon
              i.mdi.mdi-magnify
      
      #search-results.mt-3(style="max-height: 300px; overflow-y: auto;")
        // Dynamic search results will go here
        
      .field.mt-5
        button.button.is-danger.is-outlined(type="button" id="delete-all-rivals")
          span.icon
            i.mdi.mdi-delete-sweep
          span Delete All Rivals

  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-edit
        | Rival Score Comparison
    .card-content
      h5 Select rival to compare with:
      .field
        .control
          .select.is-fullwidth
            select.select(id="rivallist")
              option(value=0) Choose rival

      table.table(id="scorecompare" style="width:100%")
        thead
          tr    
            th ID
            th Song
            th Difficulty
            th Your Score
            th Rival's Score
            th Time
        tbody

//div(hidden id='data-pass') !{JSON.stringify(profile)}
div(hidden id='rivals-pass') !{JSON.stringify(rivals)}
div(hidden id='profile-pass') !{JSON.stringify(yourprofile)}
div(hidden id='profiles-pass') !{JSON.stringify(profiles)}
script(src="static/asset/js/rivals.js") 
script(src="static/asset/js/datatables.js")