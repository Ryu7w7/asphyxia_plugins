//DATA//
  profiles: DB.Find(null, { collection: 'profile' })

-
  function docOf(p) {
    try {
      var d = (p || {}).data;
      if (typeof d === "string") d = JSON.parse(d);
      return d || {};
    } catch (e) { return {}; }
  }
  function leaf(v) {
    if (v == null) return "";
    if (typeof v === "object") {
      var c = v["@content"];
      if (Array.isArray(c)) return c.length ? c[0] : "";
      return c == null ? "" : c;
    }
    return v;
  }
  function str(v, d) {
    var s = leaf(v);
    s = (s == null || s === "") ? (d || "") : String(s);
    return s;
  }
  function num(v) { var n = parseInt(leaf(v), 10); return isNaN(n) ? 0 : n; }

  var rows = [];
  for (var i = 0; i < profiles.length; i++) {
    var p    = profiles[i];
    var d    = docOf(p);             // d = p.data (echo blob)
    var prof = d.usr_profile || {};
    if (Array.isArray(prof)) prof = prof[0] || {};

    var nameStr = str(prof.usr_name, "");
    if (!nameStr) {
      for (var _k in prof) {
        if (/usr_?name/i.test(_k)) { nameStr = str(prof[_k], ""); if (nameStr) break; }
      }
    }
    if (!nameStr) nameStr = "PLAYER";

    var pinfo = d.usr_play_info || {};
    if (Array.isArray(pinfo)) pinfo = pinfo[0] || {};

    var rawScores = Array.isArray(p.scores) ? p.scores : [];
    var charts = {};
    for (var j = 0; j < rawScores.length; j++) {
      var s = rawScores[j];
      var k = (s.music_id || 0) + ":" + (s.chart_difficulty_type || 0);
      if (!charts[k] || (s.score || 0) > charts[k]) charts[k] = s.score || 0;
    }

    rows.push({
      refid:      p.refid || p.__refid || "",
      name:       nameStr,
      usrId:      p.usr_id || 0,
      rank:       num(prof.usr_rank),
      exp:        num(prof.exp),
      plays:      rawScores.length,
      charts:     Object.keys(charts).length,
      totalPlays: Math.max(num(pinfo.game_play_count), num(pinfo.total_play_count)),
      crewId:     p.crew_id || "—",
    });
  }
  rows.sort(function(a, b) { return b.exp - a.exp; });

.table-container
  table.table.is-fullwidth.is-hoverable.is-striped
    thead
      tr
        th #
        th Player
        th ID
        th Crew
        th Rank
        th EXP
        th Plays
        th Charts
    tbody
      each r, idx in rows
        tr
          td= idx + 1
          td
            a(href="profile?refid=" + r.refid)= r.name
          td.has-text-grey= r.usrId || "—"
          td= r.crewId
          td= r.rank
          td= r.exp.toLocaleString()
          td= r.plays.toLocaleString()
          td= r.charts.toLocaleString()
