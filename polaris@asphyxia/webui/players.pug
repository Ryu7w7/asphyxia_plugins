//DATA//
  profiles: DB.Find(null, { collection: 'profile' })

-
  function docOf(p) {
    try {
      var d = p.data;
      if (typeof d === "string") d = JSON.parse(d);
      return d || {};
    } catch (e) { return {}; }
  }
  function leaf(v) {
    if (v == null) return "";
    if (typeof v === "object") {
      var c = v["@content"];
      if (Array.isArray(c)) return c.length ? c[0] : "";
      return c == null ? "" : c;
    }
    return v;
  }
  function str(v, d) {
    var s = leaf(v);
    s = (s == null || s === "") ? (d || "") : String(s);
    return s;
  }
  var rows = [];
  for (const p of profiles) {
    const d = docOf(p);
    const echo = d.data || {};
    const prof = echo.usr_profile || {};
    const scores = Array.isArray(d.scores) ? d.scores : [];
    rows.push({
      refid: p.__refid || d.refid || "",
      name: str(prof.usr_name, "PLAYER"),
      rank: parseInt(leaf(prof.usr_rank), 10) || 0,
      exp: parseInt(leaf(prof.exp), 10) || 0,
      usr_id: p.usr_id || d.usr_id || 0,
      crew_id: p.crew_id || d.crew_id || "",
      plays: scores.length,
    });
  }
  rows.sort((a, b) => b.exp - a.exp);

div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-multiple
        | Polaris Chord Profiles
    .card-content
      table.table.is-fullwidth.is-striped.is-hoverable
        thead
          tr
            th Name
            th Rank
            th EXP
            th Plays
            th Crew ID
            th Usr ID
        tbody
          each r in rows
            tr
              td
                a(href=`profile_scores?refid=${r.refid}`)= r.name
              td= r.rank
              td= r.exp
              td= r.plays
              td= r.crew_id
              td= r.usr_id
