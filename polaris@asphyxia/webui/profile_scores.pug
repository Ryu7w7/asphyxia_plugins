//DATA//
  profile: DB.FindOne(refid, { collection: 'profile' })

-
  // ── helpers ────────────────────────────────────────────────────────────────
  function docOf(p) {
    try {
      var d = (p || {}).data;
      if (typeof d === "string") d = JSON.parse(d);
      return d || {};
    } catch (e) { return {}; }
  }
  function leaf(v) {
    if (v == null) return "";
    if (typeof v === "object") {
      var c = v["@content"];
      if (Array.isArray(c)) return c.length ? c[0] : "";
      return c == null ? "" : c;
    }
    return v;
  }
  function num(v) { var n = parseInt(leaf(v), 10); return isNaN(n) ? 0 : n; }
  function str(v, d) {
    var s = leaf(v);
    s = (s == null || s === "") ? (d || "") : String(s);
    return s;
  }
  function pct(r) {
    var v = parseInt(String(r), 10);
    return isNaN(v) ? "0.00%" : (v / 100).toFixed(2) + "%";
  }
  function scoreRankLabel(r) {
    var v = parseInt(String(r), 10) || 0;
    return ["D","C","B","A","S","SS","SSS"][v] || ("R" + v);
  }
  function scoreRankCls(r) {
    var v = parseInt(String(r), 10) || 0;
    return ["is-light","is-light","","is-info","is-warning","is-danger","is-dark"][v] || "";
  }
  function clearInfo(cs) {
    var v = parseInt(String(cs), 10) || 0;
    if (v >= 10) v = Math.floor(v / 10);
    if (v >= 4) return { label: "PFC", cls: "is-warning is-light" };
    if (v >= 3) return { label: "FC",  cls: "is-success" };
    if (v >= 2) return { label: "CLR", cls: "is-info" };
    if (v >= 1) return { label: "AC",  cls: "is-light" };
    return           { label: "FAIL", cls: "is-danger is-light" };
  }
  var DIFF_LABEL = ["NOV","ADV","EXH","INF","MXM"];
  var DIFF_CLS   = ["is-primary is-light","is-warning is-light","is-danger is-light","is-purple","is-dark is-light"];

  // ── data (FIXED: p.data = echo blob; p.scores = score log) ───────────────
  const p     = profile || {};
  const d     = docOf(p);           // d = p.data  (the XRPC echo: usr_profile, usr_play_info …)
  var prof    = d.usr_profile || {};
  if (Array.isArray(prof)) prof = prof[0] || {};

  var nameStr = str(prof.usr_name, "");
  if (!nameStr) {
    for (var _k in prof) {
      if (/usr_?name/i.test(_k)) { nameStr = str(prof[_k], ""); if (nameStr) break; }
    }
  }
  if (!nameStr) nameStr = "PLAYER";

  const usrId  = p.usr_id  || 0;
  const crewId = p.crew_id || "—";
  const rank   = num(prof.usr_rank);
  const exp    = num(prof.exp);

  var pinfo = d.usr_play_info || {};
  if (Array.isArray(pinfo)) pinfo = pinfo[0] || {};
  const totalPlays = Math.max(num(pinfo.game_play_count), num(pinfo.total_play_count));

  // Scores are plain-number objects stored at p.scores (ROOT), not d.scores
  const rawScores = Array.isArray(p.scores) ? p.scores : [];

  var best = {};
  for (var i = 0; i < rawScores.length; i++) {
    var s   = rawScores[i];
    var mid  = s.music_id             || 0;
    var diff = s.chart_difficulty_type || 0;
    var k    = mid + ":" + diff;
    var sc   = s.score                || 0;
    if (!best[k]) best[k] = { music_id: mid, diff: diff, score: 0, rate: 0, srank: 0, combo: 0, clear: 0, plays: 0, clears: 0 };
    best[k].plays++;
    var cs = s.clear_status || 0; if (cs >= 10) cs = Math.floor(cs / 10);
    if (cs >= 2) best[k].clears++;
    if (sc > best[k].score) {
      best[k].score  = sc;
      best[k].rate   = s.achievement_rate || 0;
      best[k].srank  = s.score_rank       || 0;
      best[k].combo  = s.combo            || 0;
      best[k].clear  = s.clear_status     || 0;
    }
  }
  var rows = Object.values(best).sort(function(a, b) { return b.score - a.score; });

if !profile
  .notification.is-warning
    | This player hasn't played Polaris Chord yet.
else
  // ── profile card ──────────────────────────────────────────────────────────
  .card(style="margin-bottom:1rem")
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account-circle
        | &nbsp;#{nameStr}
        span.has-text-grey-light(style="font-weight:normal;margin-left:.5rem") &nbsp;##{usrId}
    .card-content
      .columns.is-multiline
        .column.is-narrow
          .has-text-grey-light(style="font-size:.75rem") CREW ID
          strong= crewId
        .column.is-narrow
          .has-text-grey-light(style="font-size:.75rem") RANK
          strong= rank
        .column.is-narrow
          .has-text-grey-light(style="font-size:.75rem") EXP
          strong= exp.toLocaleString()
        .column.is-narrow
          .has-text-grey-light(style="font-size:.75rem") PLAYS (game)
          strong= totalPlays.toLocaleString()
        .column.is-narrow
          .has-text-grey-light(style="font-size:.75rem") PLAYS (logged)
          strong= rawScores.length.toLocaleString()
        .column.is-narrow
          .has-text-grey-light(style="font-size:.75rem") CHARTS PLAYED
          strong= rows.length.toLocaleString()

  // ── score table ───────────────────────────────────────────────────────────
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-music-note
        | &nbsp;Best Scores (#{rows.length})
    .card-content(style="padding:.75rem;overflow-x:auto")
      if !rows.length
        p.has-text-grey No scores recorded yet.
      else
        table.table.is-fullwidth.is-hoverable.is-striped(style="font-size:.85rem")
          thead
            tr
              th Music
              th Diff
              th Score
              th Rate
              th Grade
              th Combo
              th Clear
              th Plays
          tbody
            each r in rows
              - var ci = clearInfo(r.clear)
              tr
                td= r.music_id
                td
                  span.tag(class=DIFF_CLS[r.diff] || "")= DIFF_LABEL[r.diff] || r.diff
                td
                  strong= r.score.toLocaleString()
                td= pct(r.rate)
                td
                  span.tag(class=scoreRankCls(r.srank))= scoreRankLabel(r.srank)
                td= r.combo.toLocaleString()
                td
                  span.tag(class=ci.cls)= ci.label
                td #{r.clears}/#{r.plays}
