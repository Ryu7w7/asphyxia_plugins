//DATA//
  profile: DB.FindOne(refid, { collection: 'profile' })

-
  function docOf(p) {
    try {
      var d = (p || {}).data;
      if (typeof d === "string") d = JSON.parse(d);
      return d || {};
    } catch (e) { return {}; }
  }
  function leaf(v) {
    if (v == null) return "";
    if (typeof v === "object") {
      var c = v["@content"];
      if (Array.isArray(c)) return c.length ? c[0] : "";
      return c == null ? "" : c;
    }
    return v;
  }
  function num(v) { var n = parseInt(leaf(v), 10); return isNaN(n) ? 0 : n; }
  function str(v, d) {
    var s = leaf(v);
    s = (s == null || s === "") ? (d || "") : String(s);
    return s;
  }
  var DIFF = ["NOV", "ADV", "EXH", "INF", "MXM"];
  const d = docOf(profile);
  const echo = d.data || {};
  const prof = echo.usr_profile || {};
  const scores = Array.isArray(d.scores) ? d.scores : [];
  var best = {};
  for (const s of scores) {
    const mid = num(s.music_id);
    const diff = num(s.chart_difficulty_type);
    const k = mid + ":" + diff;
    const sc = num(s.score);
    if (!best[k] || sc > best[k].score) {
      best[k] = {
        music_id: mid, diff: diff,
        score: sc,
        rate: num(s.achievement_rate),
        rank: num(s.score_rank),
        combo: num(s.combo),
        clear: num(s.clear_status),
      };
    }
    best[k].plays = (best[k].plays || 0) + 1;
    var cs = num(s.clear_status); if (cs >= 10) cs = Math.floor(cs / 10); if (cs >= 2) best[k].clears = (best[k].clears || 0) + 1;
  }
  var rows = Object.values(best).sort((a, b) => a.music_id - b.music_id || a.diff - b.diff);

div
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-account
        | #{str(prof.usr_name, "PLAYER")} (#{p.usr_id || d.usr_id || ""})
    .card-content
      table.basic_data
        tr
          td Crew ID
          td= p.crew_id || d.crew_id || ""
        tr
          td Rank
          td= num(prof.usr_rank)
        tr
          td EXP
          td= num(prof.exp)
        tr
          td Total plays
          td= scores.length
        tr
          td Charts played
          td= rows.length
  .card
    .card-header
      p.card-header-title
        span.icon
          i.mdi.mdi-music
        | Best scores
    .card-content
      table.table.is-fullwidth.is-striped.is-hoverable
        thead
          tr
            th Music
            th Diff
            th Score
            th Rate
            th Rank
            th Combo
            th Clear
            th Plays
        tbody
          each r in rows
            tr
              td= r.music_id
              td= DIFF[r.diff] || r.diff
              td= r.score
              td= r.rate
              td= r.rank
              td= r.combo
              td= r.clear
              td= r.plays
