  - const scoreRankIndex = (record) => { if (!record || Number(record.score) <= 0) return 0; const saved = Number(record.clear_rank); if (saved > 0 && saved < rankImageNames.length) return saved; const score = Number(record.score); return score < 50000 ? 1 : score < 62000 ? 2 : score < 72000 ? 3 : score < 77000 ? 4 : score < 82000 ? 5 : score < 86000 ? 6 : score < 90000 ? 7 : score < 93000 ? 8 : score < 95000 ? 9 : score < 98000 ? 10 : score < 99000 ? 11 : 12; }
