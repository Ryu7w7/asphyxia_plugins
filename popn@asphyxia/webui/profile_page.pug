      script.
        (() => {
          const bindPreview = async (selectId, imageId, catalogUrl, officialKey, currentId) => {
            const select = document.getElementById(selectId); const image = document.getElementById(imageId);
            const gameItems = await fetch(catalogUrl).then((response) => response.ok ? response.json() : []);
            const officialItems = !{JSON.stringify(officialBoxAssets)}[officialKey] || [];
            const items = [...new Map([...gameItems, ...officialItems].map((entry) => [String(entry.id), entry])).values()].sort((a, b) => a.id - b.id);
            select.append(new Option('Default', '0'));
            for (const item of items) select.append(new Option(item.label, item.id));
            select.value = String(currentId || 0);
            const update = () => { const value = select.value; const item = items.find((entry) => String(entry.id) === value); const hasOfficial = officialItems.some((entry) => String(entry.id) === value); image.hidden = false; if (!item) { image.hidden = true; image.removeAttribute('src'); return; } image.onerror = () => { if (image.dataset.retry === '1') { image.hidden = true; return; } image.dataset.retry = '1'; if (hasOfficial) image.src = `static/asset/official_box/${officialKey}_${value.padStart(4, '0')}.png`; else image.hidden = true; }; delete image.dataset.retry; image.src = `static/asset/${item.image}`; };
            select.addEventListener('change', update); update();
          };
          bindPreview('popn-lane-cover', 'popn-lane-cover-preview', 'static/asset/lane_cover/catalog.json', 'cover', #{decor.lane_cover || 0});
          bindPreview('popn-stage-back', 'popn-stage-back-preview', 'static/asset/stage_back/catalog.json', 'stage_bk', #{decor.stage_bk || 0});
          bindPreview('popn-highlight', 'popn-highlight-preview', 'static/asset/highlight/catalog.json', 'hi_light', #{decor.highlight || 0});
        })();
