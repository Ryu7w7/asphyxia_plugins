  - const favoriteMusic = Array.isArray(playParams.nice) ? playParams.nice.filter((id) => Number(id) >= 0).slice(0, 10) : []
  - const scoreByMusic = scoreEntries.reduce((songs, [key, record]) => { const [musicId, sheet] = key.split(':'); if (!songs[musicId]) songs[musicId] = { musicId, sheets: Array(4).fill(null), plays: 0 }; songs[musicId].sheets[Number(sheet)] = record; songs[musicId].plays += Number(record.cnt) || 0; return songs; }, {})
  - const recentSongIds = [...recentMusic.map(String), ...Object.keys(scoreByMusic).sort((a, b) => (scoreByMusic[b].plays - scoreByMusic[a].plays) || Number(b) - Number(a))].filter((id, index, list) => list.indexOf(id) === index).slice(0, 20)
  - const recentSongRows = recentSongIds.map((musicId) => scoreByMusic[musicId] || { musicId, sheets: Array(4).fill(null), plays: 0 })
  - const favoriteRows = favoriteMusic.map(String).map((musicId) => scoreByMusic[musicId] || { musicId, sheets: Array(4).fill(null), plays: 0 })
  - const boxRange = (type, ranges) => ranges.flatMap(([from, to]) => Array.from({ length: to - from + 1 }, (_, offset) => ({ id: from + offset, label: `${type.toUpperCase()} ${(from + offset).toString().padStart(4, '0')}`, image: `official_box/${type}_${(from + offset).toString().padStart(4, '0')}.png` })))
  - const officialBoxAssets = { stage_bk: boxRange('stage_bk', [[1, 21]]), hi_light: boxRange('hi_light', [[1, 21]]), touch_th: boxRange('touch_th', [[4, 32]]), cover: boxRange('cover', [[4, 32]]), deco_sh: boxRange('deco_sh', [[1, 22]]), deco_se: boxRange('deco_se', [[1, 75], [77, 82]]) }
