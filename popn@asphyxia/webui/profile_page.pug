      script.
        (() => {
          const currentTheme = #{decor.touch_th || 0};
          const container = document.getElementById('popn-touch-themes');
          fetch('static/asset/touch_theme/catalog.json').then((response) => response.ok ? response.json() : [])
            .then((gameItems) => {
              const official = !{JSON.stringify(officialBoxAssets)}.touch_th || [];
              const items = [...new Map([...gameItems, ...official].map((entry) => [String(entry.id), entry])).values()].sort((a, b) => a.id - b.id);
              for (const item of items) {
                const label = document.createElement('label'); label.className = 'popn-touch-theme';
                const radio = document.createElement('input'); radio.type = 'radio'; radio.name = 'touch_th'; radio.value = item.id; radio.checked = item.id === currentTheme;
                const image = document.createElement('img'); image.alt = item.label; image.onerror = () => { if (image.dataset.retry === '1') { image.hidden = true; return; } image.dataset.retry = '1'; const officialThumb = official.some((entry) => String(entry.id) === String(item.id)); if (officialThumb) image.src = `static/asset/official_box/touch_th_${String(item.id).padStart(4, '0')}.png`; else image.hidden = true; }; image.src = `static/asset/${item.image}`;
                const text = document.createElement('span'); text.textContent = item.label;
                label.append(radio, image, text); container.append(label);
              }
              if (!container.querySelector('input:checked')) {
                const none = document.createElement('label'); none.className = 'popn-touch-theme';
                const radio = document.createElement('input'); radio.type = 'radio'; radio.name = 'touch_th'; radio.value = '0'; radio.checked = true;
                none.append(radio, document.createTextNode('Default theme')); container.prepend(none);
              }
            });
        })();
