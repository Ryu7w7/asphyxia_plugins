        span() High Cheers Profile Decoration
    .card-content
      form(method="post" action="/emit/updatePnmDecoration")
        input(type="hidden" name="refid" value=refid)
        label.label() Deco parts (seals) — choose one item at each in-game position
        .popn-deco-layout#popn-decoration-picker
        .field
          label.label() Deco part (seat) - background effect
          .control
            .select
              select(name="seat" id="popn-decoration-seat")
          img.popn-deco-thumb#popn-decoration-seat-thumb(alt="Seat decoration thumbnail" hidden)
        .field.mt-4
          button.button.is-primary(type="submit")
            span.icon
              i.mdi.mdi-content-save
            span() Save decoration
      script.
        (() => {
          const savedSeals = !{JSON.stringify(currentSeals)};
          const savedSeat = #{currentSeat};
          const picker = document.getElementById('popn-decoration-picker');
          const labels = ['Left / top', 'Left / bottom', 'Center / top', 'Center / middle', 'Center / bottom', 'Right / top', 'Right / bottom'];
          Promise.all([fetch('static/asset/deco/catalog.json').then((response) => response.ok ? response.json() : []), fetch('static/asset/deco_seat_preview/catalog.json').then((response) => response.ok ? response.json() : [])])
            .then(([gameSeals, gameSeats]) => {
              const official = !{JSON.stringify(officialBoxAssets)};
              const merge = (gameItems, officialItems) => [...new Map([...gameItems, ...(officialItems || [])].map((entry) => [String(entry.id), entry])).values()];
              const items = merge(gameSeals, official.deco_sh);
              const seatItems = merge(gameSeats, official.deco_se);
              const makeOptions = (select, noneText, source = items) => {
                select.append(new Option(noneText, '0'));
                for (const item of source) select.append(new Option(item.label, item.id));
              };
              for (let slot = 0; slot < 7; slot++) {
                const select = document.createElement('select'); select.name = `seal${slot}`; select.id = `popn-deco-seal-${slot}`;
                makeOptions(select, 'None'); select.value = String(savedSeals[slot] || 0);
                const label = document.createElement('label'); label.htmlFor = select.id; label.textContent = labels[slot];
                const control = document.createElement('div'); control.className = 'select is-fullwidth'; control.append(select);
                const thumbnail = document.createElement('img'); thumbnail.className = 'popn-deco-thumb'; thumbnail.alt = `${labels[slot]} thumbnail`;
              const updateThumbnail = () => { const item = items.find((entry) => String(entry.id) === select.value); const fallback = gameSeals.find((entry) => String(entry.id) === select.value); thumbnail.onerror = () => { if (fallback && item !== fallback) { thumbnail.onerror = null; thumbnail.src = `static/asset/${fallback.image}`; } else thumbnail.hidden = true; }; if (item) { thumbnail.src = `static/asset/${item.image}`; thumbnail.hidden = false; } else { thumbnail.removeAttribute('src'); thumbnail.hidden = true; } };
                select.addEventListener('change', updateThumbnail); updateThumbnail();
                const wrapper = document.createElement('div'); wrapper.className = 'popn-deco-slot'; wrapper.dataset.slot = String(slot); wrapper.append(label, control, thumbnail); picker.append(wrapper);
              }
              const seat = document.getElementById('popn-decoration-seat'); const seatThumbnail = document.getElementById('popn-decoration-seat-thumb'); makeOptions(seat, 'None', seatItems); seat.value = String(savedSeat || 0);
              const updateSeatThumbnail = () => { const item = seatItems.find((entry) => String(entry.id) === seat.value); const fallback = gameSeats.find((entry) => String(entry.id) === seat.value); seatThumbnail.onerror = () => { if (fallback && item !== fallback) { seatThumbnail.onerror = null; seatThumbnail.src = `static/asset/${fallback.image}`; } else seatThumbnail.hidden = true; }; if (item) { seatThumbnail.src = `static/asset/${item.image}`; seatThumbnail.hidden = false; } else { seatThumbnail.removeAttribute('src'); seatThumbnail.hidden = true; } };
              seat.addEventListener('change', updateSeatThumbnail); updateSeatThumbnail();
            });
        })();
