  // The catalog is generated by the Overview refresh action. Keep IDs visible
  // when it is not available rather than showing a wrong title or character.
  script.
    (() => {
      const getCatalog = (name) => fetch(`static/asset/catalog/${name}.json`).then((response) => response.ok ? response.json() : []);
      Promise.all([getCatalog('music'), getCatalog('character')]).then(([songs, characters]) => {
        const songById = new Map(songs.map((song) => [String(song.id), song]));
        const characterById = new Map(characters.map((character) => [String(character.id), character]));
        document.querySelectorAll('[data-music-id]').forEach((node) => {
          const song = songById.get(node.dataset.musicId); if (!song) return;
          node.textContent = `${node.dataset.rank}. ${song.title}`;
        });
        document.querySelectorAll('[data-music-meta]').forEach((node) => {
          const song = songById.get(node.dataset.musicMeta); if (!song) return;
          node.textContent = [song.genre, song.artist].filter(Boolean).join(' / ');
        });
        document.querySelectorAll('[data-music-tag]').forEach((node) => {
          const song = songById.get(node.dataset.musicTag); if (song) node.textContent = song.title;
        });
        const preview = document.getElementById('popn-character-preview');
        const character = preview && characterById.get(preview.dataset.characterId);
        if (!character) return;
        const detail = document.getElementById('popn-character-detail'); const icon = document.getElementById('popn-character-icon');
        detail.textContent = character.name;
        // iconImage is the pre-copied portrait (icon-<id>.png). When this dump
        // predates that step, fall back to the raw extracted icon archive, then
        // to the generated placeholder. Never show a broken image.
        const iconFallback = character.icon ? `static/asset/catalog/character/_icon_ifs/icon_ifs/${character.icon}.png` : null;
        const iconSource = character.iconImage ? `static/asset/${character.iconImage}` : iconFallback || `static/asset/catalog/character/icon-missing.png`;
        icon.src = iconSource;
        icon.hidden = false;
        icon.onerror = () => { icon.src = `static/asset/catalog/character/icon-missing.png`; };
        const art = character.image ? `static/asset/${character.image}` : null;
        if (art) {
          const image = document.createElement('img'); image.src = art; image.alt = character.name;
          image.style.cssText = 'width:100%;height:100%;min-height:255px;object-fit:cover;object-position:center;'; image.onerror = () => image.remove(); preview.prepend(image);
        } else {
          // No full-body art extracted for this character yet. Fill the
          // placeholder with the portrait icon and offer one-click extraction.
          const image = document.createElement('img'); image.src = icon.src; image.alt = character.name;
          image.style.cssText = 'width:100%;height:100%;min-height:255px;object-fit:contain;background:transparent;'; image.onerror = () => image.remove(); preview.prepend(image);
          const extract = document.getElementById('popn-character-extract'); if (!extract) return;
          extract.hidden = false;
          extract.onclick = async () => {
            extract.disabled = true; extract.textContent = 'Extracting...';
            try {
              const response = await fetch('/emit/syncPnmCharacterArt', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ characterId: preview.dataset.characterId }) });
              const result = await response.json();
              if (result && result.status === 'ok' && result.image) location.reload();
              else { extract.textContent = `Failed (${result && result.logs && result.logs.length ? result.logs[result.logs.length - 1] : 'no data dir?'})`; extract.disabled = false; }
            } catch {
              extract.textContent = 'Failed to reach server'; extract.disabled = false;
            }
          };
        }
      });
    })();
